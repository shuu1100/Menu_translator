# ==========================================
# Menu Translator - Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local VLM Inference (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL=qwen3-vl:8b
INFERENCE_TIMEOUT_SECONDS=300

# Culinary Knowledge Base / Database
DATABASE_PATH=data/culinary_knowledge.db

# Upload Limits & File Handling
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=["image/jpeg","image/png","image/webp"]
IMAGE_MAX_DIMENSION=1024

# Frontend Public API URL (used by Next.js PWA)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Representative Food Image Search (Optional)
# If no API key is provided, the backend seamlessly uses the built-in curated culinary image database
# and open educational sources (Wikimedia Commons).
IMAGE_SEARCH_PROVIDER=auto
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
PEXELS_API_KEY=
IMAGE_CACHE_TTL_SECONDS=86400
IMAGE_SEARCH_TIMEOUT_SECONDS=3.5
